# ==============================================================================
# VI TÍNH AN TÂM — Cấu hình môi trường (copy file này thành .env.local)
# Lấy giá trị tại: Supabase Dashboard → Project Settings → API
# ==============================================================================

# Supabase (bắt buộc để đơn hàng/kho lưu vào DB thay vì file local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Service role key (server-side, bỏ qua RLS) — KHÔNG dùng NEXT_PUBLIC_ prefix
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_SECRET_KEY

# Ký session nội bộ (tùy chọn — tự sinh nếu bỏ trống)
# SESSION_SECRET=

# Gửi email thông báo nội bộ qua Resend (tùy chọn)
# RESEND_API_KEY=

# Zalo Bot API (bot-api.zapps.me) — BẢO MẬT: Chỉ đọc từ env, KHÔNG lưu DB
# Lấy Token & Secret Token tại: https://bot.zapps.vn/docs/create-bot/
# ZALO_BOT_TOKEN=YOUR_BOT_ID:YOUR_BOT_SECRET
# ZALO_BOT_SECRET_TOKEN=your_webhook_secret_token
# ZALO_BOT_API_BASE_URL=https://bot-api.zapps.me
# ZALO_BOT_CHAT_ID=1234567890123
# CUSTOM_WEBHOOK_URL=https://your-n8n.example.com/webhook/vitinh-antam

# Seed admin password (optional - auto-generated if not set)
# SEED_ADMIN_PASSWORD=

